<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Amazon.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Amazon"
    xmlns:views="clr-namespace:Amazon.Views"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Inventory"
        ContentTemplate="{DataTemplate views:InventoryManagementView}"
        Route="InventoryManagementView" />

    <ShellContent
        Title="Shop"
        ContentTemplate="{DataTemplate views:ShopView}"
        Route="ShopView" />

    <ShellContent
        Title="Shopping Cart"
        ContentTemplate="{DataTemplate views:ShoppingCartView}"
        Route="ShoppingCartView" />

    <ShellContent
        Title="Configuration"
        ContentTemplate="{DataTemplate views:ConfigView}"
        Route="ConfigView" />

</Shell>
