<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Amazon.ViewModels"
             x:Class="Amazon.Views.ConfigView"
             x:DataType="viewmodels:ConfigViewModel"
             Title="Configuration">

    <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto">
        <Label Text="Settings"
               Grid.Row="0"
               FontSize="24"
               FontAttributes="Bold"
               Margin="0,0,0,20"/>
        
        <VerticalStackLayout Grid.Row="1" Spacing="15">
            <Label Text="Tax Rate Configuration" 
                   FontSize="18"
                   FontAttributes="Bold"/>
            
            <Label Text="Set the tax rate percentage for your cart calculations:" 
                   FontSize="14"
                   TextColor="Gray"/>
                   
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                <Label Text="Tax Rate:"
                       VerticalOptions="Center"
                       FontAttributes="Bold"/>
                
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="30"
                        Value="{Binding TaxRate, Converter={StaticResource TaxRateConverter}}"
                        MinimumTrackColor="#0056B3"
                        MaximumTrackColor="#E0E0E0"
                        ThumbColor="#0056B3"
                        Margin="10,0"/>
                        
                <Label Grid.Column="2"
                       Text="{Binding TaxRatePercentage}"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="#0056B3"
                       HorizontalOptions="End"
                       VerticalOptions="Center"/>
            </Grid>
            
            <Button Text="Save Configuration" 
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#0056B3"
                    TextColor="White"
                    Margin="0,20,0,0"
                    HorizontalOptions="End"/>
        </VerticalStackLayout>
        
        <Button Grid.Row="3"
                Text="Go Back"
                Command="{Binding GoBackCommand}"
                BackgroundColor="Gray"
                TextColor="White"
                HorizontalOptions="Start"/>
    </Grid>
</ContentPage> 