<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Amazon.ViewModels"
             xmlns:converters="clr-namespace:Amazon.Converters"
             x:Class="Amazon.Views.ConfigView"
             x:DataType="viewmodels:ConfigViewModel"
             Title="Configuration"
             BackgroundColor="#121212">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:TaxRateConverter x:Key="TaxRateConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto">
        <Label Text="Tax Configuration"
               Grid.Row="0"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="White"
               Margin="0,20,0,20"/>
        
        <Frame Grid.Row="1" 
               BackgroundColor="#202020" 
               BorderColor="#404040" 
               CornerRadius="10" 
               Padding="15">
            <VerticalStackLayout Spacing="20">
                <Label Text="Set the tax rate percentage for your cart calculations:" 
                       FontSize="16"
                       TextColor="#E0E0E0"/>
                       
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                    <Label Text="Tax Rate:"
                           VerticalOptions="Center"
                           TextColor="White"
                           FontAttributes="Bold"/>
                    
                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="30"
                            Value="{Binding TaxRate, Converter={StaticResource TaxRateConverter}}"
                            MinimumTrackColor="#0094FF"
                            MaximumTrackColor="#404040"
                            ThumbColor="#0094FF"
                            Margin="10,0"/>
                            
                    <Label Grid.Column="2"
                           Text="{Binding TaxRatePercentage}"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="#0094FF"
                           HorizontalOptions="End"
                           VerticalOptions="Center"/>
                </Grid>
                
                <Label Text="The tax rate will be applied to all cart calculations" 
                       TextColor="#A0A0A0"
                       FontSize="14"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0"/>
                       
                <Button Text="Save Configuration" 
                        Command="{Binding SaveCommand}"
                        BackgroundColor="#28A745"
                        TextColor="White"
                        Margin="0,10,0,0"
                        HeightRequest="45"
                        CornerRadius="5"
                        HorizontalOptions="Fill"/>
            </VerticalStackLayout>
        </Frame>
        
        <Button Grid.Row="3"
                Text="Back"
                Command="{Binding GoBackCommand}"
                BackgroundColor="#444444"
                TextColor="White"
                Margin="0,20,0,0"
                HeightRequest="45"
                CornerRadius="5"
                HorizontalOptions="Start"
                WidthRequest="120"/>
    </Grid>
</ContentPage> 