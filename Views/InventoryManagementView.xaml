<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Amazon.ViewModels"
             xmlns:models="clr-namespace:Amazon.Models"
             xmlns:converters="clr-namespace:Amazon.Converters"
             x:Class="Amazon.Views.InventoryManagementView"
             x:DataType="viewmodels:InventoryManagementVM"
             Title="Inventory Management">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Back Button -->
        <Button Grid.Row="0"
                Text="←"
                FontSize="24"
                Command="{Binding GoToMainCommand}"
                HorizontalOptions="Start"
                Margin="10"
                BackgroundColor="Gray"
                TextColor="White"/>

        <Grid.Resources>
            <ResourceDictionary>
                <Style x:Key="EntryStyle" TargetType="Entry">
                    <Setter Property="Margin" Value="10,5"/>
                </Style>
                <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
                <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            </ResourceDictionary>
        </Grid.Resources>

        <!-- Selected Product Display Section (visible when product selected but not editing) -->
        <Frame Grid.Row="1" 
               Padding="15" 
               Margin="10"
               CornerRadius="8"
               BorderColor="Gray"
               IsVisible="{Binding SelectedProduct, Converter={StaticResource IsNotNullConverter}}"
               BackgroundColor="#121212">
               
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="{Binding SelectedProduct.Name}"
                           FontSize="20"
                           FontAttributes="Bold"/>
                    <Label Text="{Binding SelectedProduct.Description}"
                           FontSize="16"/>
                    <Label Text="{Binding SelectedProduct.StockQuantity, StringFormat='In Stock: {0}'}"
                           FontSize="14"
                           TextColor="Gray"/>
                </VerticalStackLayout>
                
                <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                    <Label Text="{Binding SelectedProduct.Price, StringFormat='${0:F2}'}"
                           FontSize="22"
                           TextColor="ForestGreen"
                           FontAttributes="Bold"
                           HorizontalOptions="End"/>
                           
                    <Button Text="Edit Product"
                            Clicked="OnEditProductClicked"
                            HorizontalOptions="End"
                            BackgroundColor="#0056B3"
                            TextColor="White"/>
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Product Input Section (only visible when editing) -->
        <Frame Grid.Row="2" 
              Padding="10" 
              BackgroundColor="#202020"
              BorderColor="#0078D7"
              HasShadow="True"
              Margin="10"
              IsVisible="{Binding IsEditing}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
    
                <Label Text="Edit Product Details" 
                       Grid.Row="0"
                       Grid.ColumnSpan="2"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#0078D7"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10"/>
    
                <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                    <Entry Placeholder="Product Name" 
                           Text="{Binding SelectedProduct.Name}"
                           Style="{StaticResource EntryStyle}"/>
    
                    <Entry Placeholder="Description" 
                           Text="{Binding SelectedProduct.Description}"
                           Style="{StaticResource EntryStyle}"/>
                </VerticalStackLayout>
    
                <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                    <Entry Placeholder="Price" 
                           Keyboard="Numeric"
                           Text="{Binding SelectedProduct.Price}"
                           Style="{StaticResource EntryStyle}"/>
    
                    <Entry Placeholder="Stock Quantity" 
                           Keyboard="Numeric"
                           Text="{Binding SelectedProduct.StockQuantity}"
                           Style="{StaticResource EntryStyle}"/>
                           
                    <Button Text="Done Editing" 
                            Clicked="OnDoneEditingClicked"
                            Margin="10,10,0,0"
                            BackgroundColor="#1E7E34"
                            TextColor="White"
                            HorizontalOptions="End"/>
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Product List -->
        <CollectionView Grid.Row="3" 
                        ItemsSource="{Binding Products}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedProduct}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Grid Padding="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding Name}" 
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding Description}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                   HorizontalOptions="End"/>
                            <Label Text="{Binding StockQuantity, StringFormat='Stock: {0}'}"
                                   HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Action Buttons -->
        <HorizontalStackLayout Grid.Row="4" 
                              HorizontalOptions="Center" 
                              Spacing="10"
                              Padding="0,10">
            <Button Text="Add Product" 
                    Command="{Binding AddProductCommand}"
                    WidthRequest="140"
                    BackgroundColor="#0056B3"
                    TextColor="White"/>

            <Button Text="Delete Product" 
                    Command="{Binding DeleteProductCommand}"
                    IsEnabled="{Binding SelectedProduct, Converter={StaticResource IsNotNullConverter}}"
                    WidthRequest="140"
                    BackgroundColor="#BD2130"
                    TextColor="White"/>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>