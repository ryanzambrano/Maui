<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Amazon.ViewModels"
             xmlns:models="clr-namespace:Amazon.Models"
             x:Class="Amazon.Views.ShopView"
             x:DataType="viewmodels:ShopViewModel"
             Title="Shop">

    <Grid RowDefinitions="*, Auto">
        <!-- Product List -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Products}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Grid Padding="10" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="{Binding Name}" 
                                   FontSize="20"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding Description}"
                                   FontSize="16"/>
                            <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                   FontSize="18"
                                   TextColor="ForestGreen"/>
                            <Label Text="{Binding StockQuantity, StringFormat='In Stock: {0}'}"
                                   FontSize="14"
                                   TextColor="Gray"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Add to Cart"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ShopViewModel}}, Path=AddToCartCommand}"
                                CommandParameter="{Binding .}"
                                IsEnabled="{Binding StockQuantity, Converter={StaticResource GreaterThanZeroConverter}}"
                                BackgroundColor="ForestGreen"
                                TextColor="White"
                                VerticalOptions="Center"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Cart Summary -->
        <Grid Grid.Row="1" 
              Padding="20"
              ColumnDefinitions="*, Auto"
              BackgroundColor="WhiteSmoke">
            
            <VerticalStackLayout Grid.Column="0" Spacing="5">
                <Label Text="{Binding Cart.Subtotal, StringFormat='Subtotal: ${0:F2}'}"
                       FontAttributes="Bold"/>
                <Label Text="{Binding Cart.Tax, StringFormat='Tax (7%): ${0:F2}'}"/>
                <Label Text="{Binding Cart.Total, StringFormat='Total: ${0:F2}'}"
                       FontAttributes="Bold"
                       FontSize="Large"/>
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Checkout"
                    Command="{Binding CheckoutCommand}"
                    IsEnabled="{Binding Cart.Items.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                    BackgroundColor="ForestGreen"
                    TextColor="White"
                    VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage> 