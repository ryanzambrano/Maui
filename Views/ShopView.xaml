<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Amazon.ViewModels"
             xmlns:models="clr-namespace:Amazon.Models"
             xmlns:converters="clr-namespace:Amazon.Converters"
             x:Class="Amazon.Views.ShopView"
             x:DataType="viewmodels:ShopViewModel"
             x:Name="ShopPage"
             Title="Shop"
             NavigationPage.HasBackButton="True">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <Grid.Resources>
            <ResourceDictionary>
                <converters:CartSubtotalConverter x:Key="CartSubtotalConverter"/>
                <converters:CartTaxConverter x:Key="CartTaxConverter"/>
                <converters:CartTotalConverter x:Key="CartTotalConverter"/>
                <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
                <converters:IsNotMainCartConverter x:Key="IsNotMainCartConverter"/>
            </ResourceDictionary>
        </Grid.Resources>

        <!-- Back Button and Sort Controls -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0"
                    Text="Back"
                    Command="{Binding GoToMainCommand}"
                    HorizontalOptions="Start"
                    Margin="10"
                    BackgroundColor="Gray"
                    TextColor="White"/>
            
            <Label Grid.Column="1"
                   Text="Sort By:"
                   VerticalOptions="Center"
                   HorizontalOptions="End"
                   Margin="0,0,5,0"/>
                   
            <Button Grid.Column="2"
                    Text="Name"
                    Command="{Binding SortByNameCommand}"
                    Margin="5,10"
                    Padding="10,5"
                    BackgroundColor="#0056B3"
                    TextColor="White"/>
                    
            <Button Grid.Column="3"
                    Text="Price"
                    Command="{Binding SortByPriceCommand}"
                    Margin="5,10,10,10"
                    Padding="10,5"
                    BackgroundColor="#0056B3"
                    TextColor="White"/>
        </Grid>

        

        <!-- Product List -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Products}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Grid Padding="10" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="{Binding Name}" 
                                   FontSize="20"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding Description}"
                                   FontSize="16"/>
                            <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                   FontSize="18"
                                   TextColor="ForestGreen"/>
                            <Label Text="{Binding StockQuantity, StringFormat='In Stock: {0}'}"
                                   FontSize="14"
                                   TextColor="Gray"/>
                        </VerticalStackLayout>

                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,5">
                                <Entry x:Name="QuantityEntry"
                                       Placeholder="Qty"
                                       Text="1"
                                       Keyboard="Numeric"
                                       WidthRequest="50"
                                       MaxLength="3"/>
                                <Button Text="+"
                                        BackgroundColor="#0056B3"
                                        TextColor="White"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Clicked="OnAddMultipleToCartClicked"
                                        CommandParameter="{Binding .}"/>
                            </HorizontalStackLayout>
                            
                            <Button Grid.Row="1"
                                    Text="Add to Cart"
                                    Clicked="OnAddToCartClicked"
                                    CommandParameter="{Binding .}"
                                    IsEnabled="{Binding StockQuantity, Converter={StaticResource GreaterThanZeroConverter}}"
                                    BackgroundColor="blue"
                                    TextColor="White"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Cart/Wishlist Tabs -->
        <Grid Grid.Row="1" Padding="5,2" BackgroundColor="#202020" HeightRequest="40">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="5" x:Name="CartTabsContainer">
                    <!-- Dynamic tabs for carts/wishlists - Simplified without converters -->
                    <CollectionView ItemsSource="{Binding ShoppingCarts}" 
                                  HorizontalOptions="Start"
                                  SelectionMode="None"
                                  HeightRequest="30">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ShoppingCart">
                                <Border StrokeShape="RoundRectangle 5,5,5,5" 
                                        Padding="8,0"
                                        BackgroundColor="#0056B3"
                                        HeightRequest="30"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            CommandParameter="{Binding .}"
                                            Tapped="OnCartTabTapped"/>
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <Label Grid.Column="0" 
                                              Text="{Binding Name}" 
                                              TextColor="White" 
                                              FontSize="12"
                                              VerticalOptions="Center"/>
                                        <Button Grid.Column="1" 
                                               Text="×" 
                                               FontSize="10" 
                                               WidthRequest="7" 
                                               HeightRequest="7"
                                               Padding="0"
                                               Margin="3,0,0,0"
                                               BackgroundColor="#dc3545"
                                               TextColor="White"
                                               CommandParameter="{Binding .}"
                                               IsVisible="{Binding Name, Converter={StaticResource IsNotMainCartConverter}}"
                                               Clicked="OnDeleteCartClicked"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    
                    <!-- Add new cart/wishlist button -->
                    <Button Text="Add New List +"
                            WidthRequest="90"
                            HeightRequest="30"
                            Padding="0"
                            Margin="5,0,0,0"
                            BackgroundColor="#28a745"
                            TextColor="White"
                            CornerRadius="15"
                            VerticalOptions="Center"
                            Clicked="OnAddNewCartClicked"/>
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Cart Summary -->
        <Grid Grid.Row="3" 
              Padding="20"
              ColumnDefinitions="*, Auto"
              BackgroundColor="#202020">
            
            <VerticalStackLayout Grid.Column="0" Spacing="5">
                <Label Text="{Binding CurrentCartName}" 
                       FontAttributes="Bold" 
                       FontSize="19"
                       TextColor="White"/>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,5">
                    <Label Grid.Column="0"
                           Text="Sort Cart By:"
                           VerticalOptions="Center"
                           TextColor="White"
                           FontSize="14"/>
                           
                    <Button Grid.Column="2"
                            Text="Name"
                            Command="{Binding SortCartByNameCommand}"
                            Margin="5,0"
                            Padding="8,2"
                            FontSize="12"
                            BackgroundColor="#0056B3"
                            TextColor="White"
                            HeightRequest="30"/>
                            
                    <Button Grid.Column="3"
                            Text="Price"
                            Command="{Binding SortCartByPriceCommand}"
                            Padding="8,2"
                            FontSize="12"
                            BackgroundColor="#0056B3"
                            TextColor="White"
                            HeightRequest="30"/>
                </Grid>

            
                
                <Frame BackgroundColor="#121212" 
                       Padding="10"
                       CornerRadius="10"
                       HeightRequest="150">
                    <CollectionView ItemsSource="{Binding Cart}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CartItem">
                                <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                    <Label Text="{Binding Product.Name}" 
                                           FontAttributes="Bold"
                                           TextColor="White"/>
                                    <Label Grid.Column="1" 
                                           Text="{Binding Quantity, StringFormat='x{0}'}"
                                           Margin="10,0"
                                           TextColor="White"/>
                                    <Label Grid.Column="2" 
                                           Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                           FontAttributes="Bold"
                                           Margin="5,0"
                                           TextColor="White"/>
                                    <Button Grid.Column="3"
                                           Text="×"
                                           FontSize="14"
                                           Margin="0"
                                           Padding="0"
                                           MinimumHeightRequest="25"
                                           MinimumWidthRequest="25"
                                           HeightRequest="25"
                                           WidthRequest="25"
                                           BackgroundColor="#BD2130"
                                           TextColor="White"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End"
                                           Clicked="OnRemoveCartItemClicked"
                                           CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>

                <BoxView HeightRequest="1" Color="Gray" Margin="0,5"/>
                
                <Label Text="{Binding CartSubtotal, StringFormat='Subtotal: ${0:F2}'}"
                       FontAttributes="Bold"
                       TextColor="White"/>
                <Label Text="{Binding CartTax, StringFormat='Tax (7%): ${0:F2}'}"
                       TextColor="White"/>
                <Label Text="{Binding CartTotal, StringFormat='Total: ${0:F2}'}"
                       FontAttributes="Bold"
                       FontSize="Large"
                       TextColor="White"/>
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Checkout"
                    Command="{Binding CheckoutCommand}"
                    IsEnabled="{Binding Cart.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                    BackgroundColor="ForestGreen"
                    TextColor="White"
                    VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage> 