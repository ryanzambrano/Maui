<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Amazon.ViewModels"
             xmlns:models="clr-namespace:Amazon.Models"
             xmlns:converters="clr-namespace:Amazon.Converters"
             x:Class="Amazon.Views.ShopView"
             x:DataType="viewmodels:ShopViewModel"
             x:Name="ShopPage"
             Title="Shop"
             NavigationPage.HasBackButton="True">

    <Grid RowDefinitions="Auto, *, Auto">
        <Grid.Resources>
            <ResourceDictionary>
                <converters:CartSubtotalConverter x:Key="CartSubtotalConverter"/>
                <converters:CartTaxConverter x:Key="CartTaxConverter"/>
                <converters:CartTotalConverter x:Key="CartTotalConverter"/>
                <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
            </ResourceDictionary>
        </Grid.Resources>

        <!-- Back Button and Sort Controls -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
            <Button Grid.Column="0"
                    Text="Back"
                    Command="{Binding GoToMainCommand}"
                    HorizontalOptions="Start"
                    Margin="10"
                    BackgroundColor="Gray"
                    TextColor="White"/>
            
            <Label Grid.Column="1"
                   Text="Sort By:"
                   VerticalOptions="Center"
                   HorizontalOptions="End"
                   Margin="0,0,5,0"/>
                   
            <Button Grid.Column="2"
                    Text="Name"
                    Command="{Binding SortByNameCommand}"
                    Margin="5,10"
                    Padding="10,5"
                    BackgroundColor="#0056B3"
                    TextColor="White"/>
                    
            <Button Grid.Column="3"
                    Text="Price"
                    Command="{Binding SortByPriceCommand}"
                    Margin="5,10,10,10"
                    Padding="10,5"
                    BackgroundColor="#0056B3"
                    TextColor="White"/>
        </Grid>

        <!-- Product List -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Products}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Grid Padding="10" ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="{Binding Name}" 
                                   FontSize="20"
                                   FontAttributes="Bold"/>
                            <Label Text="{Binding Description}"
                                   FontSize="16"/>
                            <Label Text="{Binding Price, StringFormat='${0:F2}'}"
                                   FontSize="18"
                                   TextColor="ForestGreen"/>
                            <Label Text="{Binding StockQuantity, StringFormat='In Stock: {0}'}"
                                   FontSize="14"
                                   TextColor="Gray"/>
                        </VerticalStackLayout>

                        <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,5">
                                <Entry x:Name="QuantityEntry"
                                       Placeholder="Qty"
                                       Text="1"
                                       Keyboard="Numeric"
                                       WidthRequest="50"
                                       MaxLength="3"/>
                                <Button Text="+"
                                        BackgroundColor="#0056B3"
                                        TextColor="White"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Clicked="OnAddMultipleToCartClicked"
                                        CommandParameter="{Binding .}"/>
                            </HorizontalStackLayout>
                            
                            <Button Grid.Row="1"
                                    Text="Add to Cart"
                                    Clicked="OnAddToCartClicked"
                                    CommandParameter="{Binding .}"
                                    IsEnabled="{Binding StockQuantity, Converter={StaticResource GreaterThanZeroConverter}}"
                                    BackgroundColor="blue"
                                    TextColor="White"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Cart Summary -->
        <Grid Grid.Row="2" 
              Padding="20"
              ColumnDefinitions="*, Auto"
              BackgroundColor="#F5F5F5">
            
            <VerticalStackLayout Grid.Column="0" Spacing="5">
                <Label Text="Your Cart" 
                       FontAttributes="Bold" 
                       FontSize="18"
                       TextColor="Black"/>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,5">
                    <Label Grid.Column="0"
                           Text="Sort Cart By:"
                           VerticalOptions="Center"
                           FontSize="14"/>
                           
                    <Button Grid.Column="2"
                            Text="Name"
                            Command="{Binding SortCartByNameCommand}"
                            Margin="5,0"
                            Padding="8,2"
                            FontSize="12"
                            BackgroundColor="#0056B3"
                            TextColor="White"
                            HeightRequest="30"/>
                            
                    <Button Grid.Column="3"
                            Text="Price"
                            Command="{Binding SortCartByPriceCommand}"
                            Padding="8,2"
                            FontSize="12"
                            BackgroundColor="#0056B3"
                            TextColor="White"
                            HeightRequest="30"/>
                </Grid>

                <Label Text="{Binding ButtonPressStatus, Mode=OneWay}"
                       FontSize="16" 
                       TextColor="Red" 
                       FontAttributes="Bold"
                       Margin="0,5,0,5"/>  
                
                <Frame BackgroundColor="White" 
                       Padding="10"
                       CornerRadius="10"
                       HeightRequest="150">
                    <CollectionView ItemsSource="{Binding Cart}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CartItem">
                                <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                    <Label Text="{Binding Product.Name}" 
                                           FontAttributes="Bold"
                                           TextColor="Black"/>
                                    <Label Grid.Column="1" 
                                           Text="{Binding Quantity, StringFormat='x{0}'}"
                                           Margin="10,0"
                                           TextColor="Black"/>
                                    <Label Grid.Column="2" 
                                           Text="{Binding Subtotal, StringFormat='${0:F2}'}"
                                           FontAttributes="Bold"
                                           Margin="5,0"
                                           TextColor="Black"/>
                                    <Button Grid.Column="3"
                                           Text="×"
                                           FontSize="14"
                                           Margin="0"
                                           Padding="0"
                                           MinimumHeightRequest="25"
                                           MinimumWidthRequest="25"
                                           HeightRequest="25"
                                           WidthRequest="25"
                                           BackgroundColor="#BD2130"
                                           TextColor="White"
                                           VerticalOptions="Center"
                                           HorizontalOptions="End"
                                           Clicked="OnRemoveCartItemClicked"
                                           CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>

                <BoxView HeightRequest="1" Color="Gray" Margin="0,5"/>
                
                <Label Text="{Binding CartSubtotal, StringFormat='Subtotal: ${0:F2}'}"
                       FontAttributes="Bold"
                       TextColor="Black"/>
                <Label Text="{Binding CartTax, StringFormat='Tax (7%): ${0:F2}'}"
                       TextColor="Black"/>
                <Label Text="{Binding CartTotal, StringFormat='Total: ${0:F2}'}"
                       FontAttributes="Bold"
                       FontSize="Large"
                       TextColor="Black"/>
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Checkout"
                    Command="{Binding CheckoutCommand}"
                    IsEnabled="{Binding Cart.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                    BackgroundColor="ForestGreen"
                    TextColor="White"
                    VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage> 